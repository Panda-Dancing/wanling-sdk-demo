# 本地环境配置文件
# 以 VITE_ 开头的变量会被 Vite 暴露给客户端代码

# 后端 API 基础地址。开发时保持 /api，由 Vite 代理转发到 VITE_API_PROXY_TARGET。
VITE_API_BASE_URL=/api

# 本地 backend 代理目标；如果后端服务在其他地址，请修改此处。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 使用本地 SDK 源码（调试模式）
# 启用后会将 @wanlingsdk/avatar-sdk 指向 ../SDK-video/src
VITE_USE_LOCAL_SDK=true

# 注意：
# 1. 修改此文件后需要重启开发服务器才能生效
# 2. 生产环境配置请创建 .env.production 文件
